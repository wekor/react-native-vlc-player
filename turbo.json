{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "package.json",
        "app.json",
        "app/**",
        "src/**",
        "assets/**",
        "babel.config.js",
        "metro.config.js",
        "react-native.config.js"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/*.podspec",
        "package.json",
        "app.json",
        "app/**",
        "src/**",
        "assets/**",
        "babel.config.js",
        "metro.config.js",
        "react-native.config.js"
      ],
      "outputs": []
    }
  }
}
